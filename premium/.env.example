# UnaabzCalc Premium: environment variables.  Copy to .env.local (never commit .env.local).
# Only variables the Phase 1 code actually reads are active. Later-phase variables are commented out.

# ---- Application ----------------------------------------------------------
# PUBLIC. Where the app is served. Local: http://localhost:3000. Set per environment in Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (Project Settings > API in your Supabase dashboard) ----------
# PUBLIC. Your project URL, e.g. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# PUBLIC. The anon / publishable key. Safe in the browser ONLY because row-level security is on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Payments (Phase 7). ALL SERVER ONLY. Leave all of them unset and payments stay OFF (nothing breaks). ----
# SECRET. Supabase > Project Settings > API > service_role key. Used only by the payment code. Never put it in a NEXT_PUBLIC_ variable.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SECRET. Paystack > Settings > API Keys. Use the TEST key (sk_test_...) until launch. The mode comes from the key itself.
# PAYSTACK_SECRET_KEY=sk_test_your_key_here
# Paystack > Products > Plans: create a MONTHLY plan whose amount equals the Premium price setting. Paste its code (PLN_...).
# PAYSTACK_PLAN_CODE=PLN_xxxxxxxx

# ---- Ads (Phase 7). Leave both unset to keep ads OFF. ----
# Your real AdSense publisher id, e.g. ca-pub-0000000000000000 (only after AdSense approves your real domain).
# ADSENSE_PUBLISHER_ID=
# The numeric ad-unit (slot) id from your AdSense account.
# ADSENSE_SLOT_ID=
